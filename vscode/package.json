{
  "name": "valency",
  "displayName": "Valency",
  "publisher": "valencyio",
  "version": "0.1.9",
  "description": "Search, discover, and analyze tens of millions of research papers and preprints.",
  "author": {
    "name": "Valency Systems Inc"
  },
  "license": "MIT",
  "homepage": "https://valency.io",
  "repository": "https://github.com/valency-oss/valency-connectors",
  "engines": {
    "vscode": "^1.109.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "assets/icon.png",
  "categories": [
    "Machine Learning",
    "Data Science",
    "Education"
  ],
  "keywords": [
    "research",
    "papers",
    "mcp",
    "semantic-search"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "valency.mcp",
        "label": "Valency"
      }
    ],
    "commands": [
      {
        "command": "valency.signIn",
        "title": "Sign in",
        "category": "Valency"
      }
    ],
    "walkthroughs": [
      {
        "id": "valency.gettingStarted",
        "title": "Get started with Valency",
        "description": "Sign in and see what was installed.",
        "steps": [
          {
            "id": "valency.signIn",
            "title": "Sign in to Valency",
            "description": "Sign in once to connect your agent to the hosted corpus. VS Code stores the sign-in and refreshes it automatically.\n[Sign in](command:valency.signIn)",
            "media": {
              "markdown": "walkthrough/sign-in.md"
            },
            "completionEvents": [
              "onCommand:valency.signIn"
            ]
          },
          {
            "id": "valency.installed",
            "title": "See what was installed",
            "description": "This extension registered the hosted Valency MCP server. Nothing runs or is stored on your machine.",
            "media": {
              "markdown": "walkthrough/installed.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm run build -- --minify"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/vscode": "~1.109.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
